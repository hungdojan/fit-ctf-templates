---
name: "{{ project_name }}_{{ username }}_privilege-escallation"

services:
  node:
    build:
      context: {{ paths__modules }}/prv-escallation
      dockerfile: Containerfile
    image: fit-ctf/prv-escallation:latest
    restart: unless-stopped
    networks:
      {{ network_map__private }}:
    volumes:
      - "{{ node__volume_map__flagfile }}:/root/flag.txt:ro"

networks:
  {{ network_map__private }}:
    external: true
